<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Paraba.DriverApp.Views.Profile.AddVehiclePage"
             Title="Registrar vehículo" BackgroundColor="#F4F4F4">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="16">
            <Label Text="Registrar vehículo" FontSize="34" FontAttributes="Bold" TextColor="#111827" />
            <Label Text="Selecciona Taxi, Mototaxi o Microbus. El registro quedará Pendiente."
                   FontSize="18" LineHeight="1.2" TextColor="#374151" />

            <Label Text="Tipo de servicio" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
            <Picker x:Name="ServiceTypePicker" Title="Selecciona un tipo de servicio"
                    ItemDisplayBinding="{Binding .}" BackgroundColor="White"
                    FontSize="18" HeightRequest="58" TextColor="#111827" TitleColor="#4B5563" />

            <Label Text="Placa" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
            <Entry x:Name="PlateEntry" Placeholder="Ingresa la placa" BackgroundColor="White"
                   FontSize="18" HeightRequest="58" TextColor="#111827" PlaceholderColor="#4B5563" />

            <Label Text="Marca" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
            <Entry x:Name="BrandEntry" Placeholder="Ingresa la marca" BackgroundColor="White"
                   FontSize="18" HeightRequest="58" TextColor="#111827" PlaceholderColor="#4B5563" />

            <Label Text="Modelo" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
            <Entry x:Name="ModelEntry" Placeholder="Ingresa el modelo" BackgroundColor="White"
                   FontSize="18" HeightRequest="58" TextColor="#111827" PlaceholderColor="#4B5563" />

            <Label Text="Color" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
            <Entry x:Name="ColorEntry" Placeholder="Ingresa el color" BackgroundColor="White"
                   FontSize="18" HeightRequest="58" TextColor="#111827" PlaceholderColor="#4B5563" />

            <Label Text="Año" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
            <Entry x:Name="YearEntry" Placeholder="Ingresa el año" Keyboard="Numeric" BackgroundColor="White"
                   FontSize="18" HeightRequest="58" TextColor="#111827" PlaceholderColor="#4B5563" />

            <Label Text="Para líneas blancas selecciona Microbus; antes de asignar una ruta también se exigirá DocumentoMicrobus aprobado."
                   TextColor="#78350F" FontSize="17" LineHeight="1.2" />
            <Button x:Name="SaveButton" Text="Guardar vehículo" Clicked="OnSaveClicked"
                    BackgroundColor="#111827" TextColor="White" FontSize="18" FontAttributes="Bold"
                    HeightRequest="58" CornerRadius="14" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
