@model Paraba.UI.ViewModels.CrearUsuarioAdminViewModel

@{
    ViewData["Title"] = "Nuevo usuario admin";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Nuevo usuario admin</h1>
        <p class="text-muted mb-0">Alta de usuario administrativo con rol operativo.</p>
    </div>
    <a asp-controller="UsuarioAdmin" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-controller="UsuarioAdmin" asp-action="Crear" method="post" class="row g-3">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <label class="form-label">Nombre completo</label>
        <input asp-for="NombreCompleto" class="form-control" />
    </div>

    <div class="col-md-6">
        <label class="form-label">Correo</label>
        <input asp-for="Correo" class="form-control" />
    </div>

    <div class="col-md-6">
        <label class="form-label">Password temporal</label>
        <input asp-for="Password" class="form-control" type="password" />
    </div>

    <div class="col-md-6">
        <label class="form-label">Rol</label>
        <select asp-for="IdRolAdmin" asp-items="Model.Roles" class="form-select"></select>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Crear usuario</button>
        <a asp-controller="UsuarioAdmin" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
