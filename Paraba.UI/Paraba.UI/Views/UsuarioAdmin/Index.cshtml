@model List<Paraba.UI.ViewModels.UsuarioAdminViewModel>

@{
    ViewData["Title"] = "Usuarios admin";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Usuarios admin</h1>
        <p class="text-muted mb-0">Gestion de accesos administrativos del panel PARABA.</p>
    </div>
    <a asp-controller="UsuarioAdmin" asp-action="Crear" class="btn btn-primary">Nuevo usuario</a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Usuario</th>
            <th>Roles</th>
            <th>Estado</th>
            <th>Intentos fallidos</th>
            <th>Ultimo acceso</th>
            <th>Registro</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.IdUsuarioAdmin</td>
                <td>
                    <strong>@usuario.NombreCompleto</strong>
                    <div class="text-muted small">@usuario.Correo</div>
                </td>
                <td>@usuario.Roles</td>
                <td>
                    <span class="status-badge @(usuario.Estado ? "status-success" : "status-danger")">
                        @(usuario.Estado ? "Activo" : "Suspendido")
                    </span>
                </td>
                <td>@usuario.IntentosFallidos</td>
                <td>@(usuario.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm") ?? "Sin acceso")</td>
                <td>@usuario.FechaRegistro.ToString("dd/MM/yyyy")</td>
                <td>
                    <div class="table-actions mb-1">
                        <a asp-controller="UsuarioAdmin" asp-action="Detalle" asp-route-id="@usuario.IdUsuarioAdmin" class="btn btn-sm btn-outline-secondary">Detalle</a>
                    </div>
                    @if (usuario.Estado)
                    {
                        <div class="table-actions">
                            <a asp-controller="UsuarioAdmin" asp-action="Suspender" asp-route-id="@usuario.IdUsuarioAdmin" class="btn btn-sm btn-outline-danger">Suspender</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-actions">
                            <a asp-controller="UsuarioAdmin" asp-action="Reactivar" asp-route-id="@usuario.IdUsuarioAdmin" class="btn btn-sm btn-outline-success">Reactivar</a>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
