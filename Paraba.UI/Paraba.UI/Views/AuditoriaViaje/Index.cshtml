@model Paraba.UI.ViewModels.AuditoriaViajeFiltroViewModel

@{
    ViewData["Title"] = "Auditoria de viajes";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Auditoria de viajes</h1>
        <p class="text-muted mb-0">Historial operativo de cambios importantes en los viajes.</p>
    </div>
</div>

<form asp-controller="AuditoriaViaje" asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">Desde</label>
        <input asp-for="FechaDesde" class="form-control" type="date" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Hasta</label>
        <input asp-for="FechaHasta" class="form-control" type="date" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Viaje</label>
        <input asp-for="IdViaje" class="form-control" type="number" min="1" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Accion</label>
        <input asp-for="Accion" class="form-control" />
    </div>
    <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filtrar</button>
    </div>
</form>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Viaje</th>
            <th>Accion</th>
            <th>Estado anterior</th>
            <th>Estado nuevo</th>
            <th>Tarifa anterior</th>
            <th>Tarifa nueva</th>
            <th>Usuario</th>
            <th>Observacion</th>
            <th>Fecha</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Auditorias)
        {
            <tr>
                <td>@item.IdAuditoriaViaje</td>
                <td>@item.IdViaje</td>
                <td>@item.Accion</td>
                <td>@item.EstadoAnterior</td>
                <td>@item.EstadoNuevo</td>
                <td>@(item.TarifaAnterior?.ToString("0.00") ?? "-")</td>
                <td>@(item.TarifaNueva?.ToString("0.00") ?? "-")</td>
                <td>@item.UsuarioSistema</td>
                <td>@item.Observacion</td>
                <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table>
