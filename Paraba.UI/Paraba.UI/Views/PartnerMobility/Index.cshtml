@model Paraba.UI.ViewModels.PartnerMobilityViewModel

@{
    ViewData["Title"] = "Servicios aliados";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1">Microbuses y asociaciones de mototaxi</h1>
        <p class="text-muted mb-0">Control de rutas, suscripciones mensuales y ranuras de trabajo vinculadas a PARABA.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="border rounded p-3"><div class="text-muted small">Rutas activas</div><div class="h4 mb-0">@Model.TotalRutasActivas</div></div></div>
    <div class="col-md-3"><div class="border rounded p-3"><div class="text-muted small">Choferes microbus</div><div class="h4 mb-0">@Model.TotalChoferesMicrobus</div></div></div>
    <div class="col-md-3"><div class="border rounded p-3"><div class="text-muted small">Ranuras mototaxi</div><div class="h4 mb-0">@Model.TotalCuposMototaxi</div></div></div>
    <div class="col-md-3"><div class="border rounded p-3"><div class="text-muted small">Ranuras disponibles</div><div class="h4 mb-0">@Model.CuposMototaxiDisponibles</div></div></div>
</div>

<section class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 class="h4 mb-0">Rutas de microbus</h2>
        <span class="badge text-bg-primary">Pasaje base Bs 2,00</span>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark"><tr><th>Ruta</th><th>Origen</th><th>Destino</th><th>Recorrido establecido</th><th>Pasaje</th><th>Suscripcion chofer</th><th>Choferes</th><th>Estado</th></tr></thead>
            <tbody>
            @foreach (var route in Model.RutasMicrobus)
            {
                <tr>
                    <td><strong>@route.Nombre</strong></td><td>@route.Origen</td><td>@route.Destino</td><td>@route.Recorrido</td>
                    <td>Bs @route.TarifaPasajeBs.ToString("0.00")</td><td>USD @route.SuscripcionMensualChoferUsd.ToString("0.00") / mes</td>
                    <td>@route.ChoferesSuscritos</td><td><span class="status-badge @(route.Estado ? "status-success" : "status-muted")">@(route.Estado ? "Activa" : "Inactiva")</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section>
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 class="h4 mb-0">Asociaciones de mototaxi</h2>
        <span class="badge text-bg-primary">USD 50,00 por 20 ranuras</span>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark"><tr><th>Asociacion</th><th>Parada</th><th>Costo mensual</th><th>Cupos</th><th>Ocupados</th><th>Disponibles</th><th>Estado</th></tr></thead>
            <tbody>
            @foreach (var association in Model.AsociacionesMototaxi)
            {
                <tr>
                    <td><strong>@association.Nombre</strong></td><td>@association.Parada</td><td>USD @association.CostoMensualUsd.ToString("0.00")</td>
                    <td>@association.CuposTotales</td><td>@association.CuposOcupados</td><td>@association.CuposDisponibles</td>
                    <td><span class="status-badge @(association.Estado ? "status-success" : "status-muted")">@(association.Estado ? "Activa" : "Inactiva")</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
