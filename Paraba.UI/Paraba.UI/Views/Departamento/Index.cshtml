@model List<Paraba.UI.ViewModels.DepartamentoViewModel>

@{
    ViewData["Title"] = "Departamentos";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Departamentos</h1>
        <p class="text-muted mb-0">Division administrativa por pais.</p>
    </div>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Pais</th>
            <th>Nombre</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var departamento in Model)
        {
            <tr>
                <td>@departamento.IdDepartamento</td>
                <td>@departamento.Pais</td>
                <td><strong>@departamento.Nombre</strong></td>
                <td>@(departamento.Estado ? "Activo" : "Inactivo")</td>
            </tr>
        }
    </tbody>
</table>
