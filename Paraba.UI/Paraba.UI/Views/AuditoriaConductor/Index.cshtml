@model Paraba.UI.ViewModels.AuditoriaConductorFiltroViewModel

@{
    ViewData["Title"] = "Auditoria conductores";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Auditoria de conductores</h1>
        <p class="text-muted mb-0">Historial de verificacion, rechazo, suspension y reactivacion.</p>
    </div>
</div>

<form asp-controller="AuditoriaConductor" asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">Desde</label>
        <input asp-for="FechaDesde" class="form-control" type="date" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Hasta</label>
        <input asp-for="FechaHasta" class="form-control" type="date" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Conductor</label>
        <select asp-for="IdConductor" asp-items="Model.Conductores" class="form-select"></select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Accion</label>
        <input asp-for="Accion" class="form-control" />
    </div>
    <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filtrar</button>
    </div>
</form>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Conductor</th>
            <th>Accion</th>
            <th>Estado anterior</th>
            <th>Estado nuevo</th>
            <th>Usuario</th>
            <th>Observacion</th>
            <th>Fecha</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Auditorias)
        {
            <tr>
                <td>@item.IdAuditoriaConductor</td>
                <td>
                    <strong>@item.Conductor</strong>
                    <div class="text-muted small">ID @item.IdConductor</div>
                </td>
                <td>@item.Accion</td>
                <td>@item.EstadoAnterior</td>
                <td>@item.EstadoNuevo</td>
                <td>@item.UsuarioSistema</td>
                <td>@item.Observacion</td>
                <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table>
