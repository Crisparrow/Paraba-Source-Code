@model List<Paraba.UI.ViewModels.CalificacionViewModel>

@{
    ViewData["Title"] = "Calificaciones";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Calificaciones</h1>
        <p class="text-muted mb-0">Opiniones de pasajeros sobre conductores despues de cada viaje.</p>
    </div>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Viaje</th>
            <th>Pasajero</th>
            <th>Conductor</th>
            <th>Puntaje</th>
            <th>Comentario</th>
            <th>Estado</th>
            <th>Fecha</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var calificacion in Model)
        {
            <tr>
                <td>@calificacion.IdCalificacion</td>
                <td>@calificacion.IdViaje</td>
                <td>@calificacion.Pasajero</td>
                <td>@calificacion.Conductor</td>
                <td><strong>@calificacion.Puntaje / 5</strong></td>
                <td>@calificacion.Comentario</td>
                <td>@(calificacion.Estado ? "Activo" : "Inactivo")</td>
                <td>@calificacion.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table>
