@model List<Paraba.ENTITY.Models.Pais>

@{
    ViewData["Title"] = "Paises";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Paises</h1>
        <p class="text-muted mb-0">Paises donde PARABA puede operar.</p>
    </div>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Codigo ISO</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pais in Model)
        {
            <tr>
                <td>@pais.IdPais</td>
                <td><strong>@pais.Nombre</strong></td>
                <td>@pais.CodigoIso</td>
                <td>@(pais.Estado ? "Activo" : "Inactivo")</td>
            </tr>
        }
    </tbody>
</table>
