@model List<Paraba.UI.ViewModels.CiudadViewModel>

@{
    ViewData["Title"] = "Ciudades";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Ciudades</h1>
        <p class="text-muted mb-0">Ciudades habilitadas para la operacion de PARABA.</p>
    </div>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Departamento</th>
            <th>Nombre</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ciudad in Model)
        {
            <tr>
                <td>@ciudad.IdCiudad</td>
                <td>@ciudad.Departamento</td>
                <td><strong>@ciudad.Nombre</strong></td>
                <td>@(ciudad.Estado ? "Activo" : "Inactivo")</td>
            </tr>
        }
    </tbody>
</table>
