@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    string IsActive(string controller, string? action = null)
    {
        bool sameController = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool sameAction = string.IsNullOrWhiteSpace(action) || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

        return sameController && sameAction ? "active" : string.Empty;
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PARABA</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Paraba.UI.styles.css" asp-append-version="true" />
</head>
<body class="admin-shell">
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <a class="admin-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="admin-brand-mark">
                    <span>P</span>
                </span>
                <span>
                    <strong>PARABA</strong>
                    <small>Indrive + Mototaxi</small>
                </span>
            </a>

            <button class="admin-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavigation" aria-expanded="false" aria-controls="adminNavigation">
                Menu
            </button>

            <nav id="adminNavigation" class="admin-nav collapse">
                <div class="admin-nav-section">
                    <span class="admin-nav-title">Inicio</span>
                    <a class="@IsActive("Home")" asp-controller="Home" asp-action="Index">Dashboard</a>
                </div>

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Operaciones") || User.IsInRole("Soporte"))
                {
                    <div class="admin-nav-section">
                        <span class="admin-nav-title">Operacion</span>
                        <a class="@IsActive("Viaje")" asp-controller="Viaje" asp-action="Index">Viajes</a>
                        <a class="@IsActive("Soporte")" asp-controller="Soporte" asp-action="Index">Soporte operativo</a>
                        <a class="@IsActive("Reclamo")" asp-controller="Reclamo" asp-action="Index">Reclamos</a>
                        <a class="@IsActive("ReporteViajes")" asp-controller="ReporteViajes" asp-action="Index">Reporte viajes</a>
                        @if (User.IsInRole("Operaciones"))
                        {
                            <a class="@IsActive("ReporteConductores")" asp-controller="ReporteConductores" asp-action="Index">Reporte conductores</a>
                        }
                        <a class="@IsActive("SimuladorTarifa")" asp-controller="SimuladorTarifa" asp-action="Index">Sugerir tarifa</a>
                    </div>
                }

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Verificador") || User.IsInRole("Soporte"))
                {
                    <div class="admin-nav-section">
                        <span class="admin-nav-title">Conductores</span>
                        <a class="@IsActive("Conductor", "Index")" asp-controller="Conductor" asp-action="Index">Conductores</a>
                        <a class="@IsActive("Conductor", "Pendientes")" asp-controller="Conductor" asp-action="Pendientes">Pendientes</a>
                        <a class="@IsActive("Vehiculo")" asp-controller="Vehiculo" asp-action="Index">Vehiculos</a>
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Verificador"))
                        {
                            <a class="@IsActive("DocumentoConductor")" asp-controller="DocumentoConductor" asp-action="Index">Documentos</a>
                        }
                        <a class="@IsActive("PerfilConductor")" asp-controller="PerfilConductor" asp-action="Index">Perfiles</a>
                        <a class="@IsActive("ReporteConductores")" asp-controller="ReporteConductores" asp-action="Index">Reporte conductores</a>
                    </div>
                }

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Soporte"))
                {
                    <div class="admin-nav-section">
                        <span class="admin-nav-title">Clientes</span>
                        <a class="@IsActive("Pasajero")" asp-controller="Pasajero" asp-action="Index">Pasajeros</a>
                        <a class="@IsActive("Calificacion")" asp-controller="Calificacion" asp-action="Index">Calificaciones</a>
                    </div>
                }

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Finanzas"))
                {
                    <div class="admin-nav-section">
                        <span class="admin-nav-title">Finanzas</span>
                        <a class="@IsActive("Liquidaciones", "Index")" asp-controller="Liquidaciones" asp-action="Index">Liquidaciones</a>
                        <a class="@IsActive("Liquidaciones", "Historial")" asp-controller="Liquidaciones" asp-action="Historial">Historial liquidaciones</a>
                        <a class="@IsActive("ReporteFinanciero")" asp-controller="ReporteFinanciero" asp-action="Index">Reporte financiero</a>
                        @if (User.IsInRole("Finanzas"))
                        {
                            <a class="@IsActive("ReporteViajes")" asp-controller="ReporteViajes" asp-action="Index">Reporte viajes</a>
                        }
                        <a class="@IsActive("ComisionServicio")" asp-controller="ComisionServicio" asp-action="Index">Comisiones</a>
                        <a class="@IsActive("Tarifa")" asp-controller="Tarifa" asp-action="Index">Tarifas</a>
                    </div>
                }

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Operaciones"))
                {
                    <div class="admin-nav-section">
                        <span class="admin-nav-title">Configuracion</span>
                        <a class="@IsActive("ReglaTarifa")" asp-controller="ReglaTarifa" asp-action="Index">Reglas tarifa</a>
                        <a class="@IsActive("TipoServicio")" asp-controller="TipoServicio" asp-action="Index">Tipos servicio</a>
                        <a class="@IsActive("TipoVia")" asp-controller="TipoVia" asp-action="Index">Tipos via</a>
                        <a class="@IsActive("EstadoViaje")" asp-controller="EstadoViaje" asp-action="Index">Estados viaje</a>
                        <a class="@IsActive("Pais")" asp-controller="Pais" asp-action="Index">Paises</a>
                        <a class="@IsActive("Departamento")" asp-controller="Departamento" asp-action="Index">Departamentos</a>
                        <a class="@IsActive("Ciudad")" asp-controller="Ciudad" asp-action="Index">Ciudades</a>
                        <a class="@IsActive("Zona")" asp-controller="Zona" asp-action="Index">Zonas</a>
                    </div>
                }

                @if (User.IsInRole("SuperAdmin"))
                {
                    <div class="admin-nav-section">
                        <span class="admin-nav-title">Seguridad</span>
                        <a class="@IsActive("UsuarioAdmin")" asp-controller="UsuarioAdmin" asp-action="Index">Usuarios admin</a>
                        <a class="@IsActive("AuditoriaAccesoAdmin")" asp-controller="AuditoriaAccesoAdmin" asp-action="Index">Auditoria accesos</a>
                        <a class="@IsActive("AuditoriaAdministrativa")" asp-controller="AuditoriaAdministrativa" asp-action="Index">Auditoria administrativa</a>
                        <a class="@IsActive("AuditoriaViaje")" asp-controller="AuditoriaViaje" asp-action="Index">Auditoria viajes</a>
                        <a class="@IsActive("AuditoriaConductor")" asp-controller="AuditoriaConductor" asp-action="Index">Auditoria conductores</a>
                    </div>
                }
            </nav>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <div>
                    <div class="admin-page-label">Panel administrativo</div>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="admin-user">
                    <span>@User.Identity?.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Salir</button>
                    </form>
                </div>
            </header>

            <main role="main" class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
