@model List<Paraba.UI.ViewModels.ConductorPendienteViewModel>

@{
    ViewData["Title"] = "Conductores pendientes";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Conductores pendientes</h1>
        <p class="text-muted mb-0">Conductores registrados que aun no estan verificados.</p>
    </div>
    <a asp-controller="DocumentoConductor" asp-action="Index" class="btn btn-primary">Revisar documentos</a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Conductor</th>
            <th>Telefono</th>
            <th>Documentos</th>
            <th>Pendientes</th>
            <th>Aprobados</th>
            <th>Rechazados</th>
            <th>Disponible</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var conductor in Model)
        {
            <tr>
                <td>@conductor.IdConductor</td>
                <td>
                    <strong>@conductor.NombreCompleto</strong>
                    <div class="text-muted small">@conductor.Correo</div>
                </td>
                <td>@conductor.Telefono</td>
                <td>@conductor.TotalDocumentos</td>
                <td><span class="status-badge status-warning">@conductor.DocumentosPendientes</span></td>
                <td><span class="status-badge status-success">@conductor.DocumentosAprobados</span></td>
                <td><span class="status-badge status-danger">@conductor.DocumentosRechazados</span></td>
                <td>
                    <span class="status-badge @(conductor.Disponible ? "status-success" : "status-muted")">
                        @(conductor.Disponible ? "Disponible" : "No disponible")
                    </span>
                </td>
                <td>
                    <span class="status-badge @(conductor.Estado ? "status-success" : "status-danger")">
                        @(conductor.Estado ? "Activo" : "Suspendido")
                    </span>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-success">
        No hay conductores pendientes de verificacion.
    </div>
}
