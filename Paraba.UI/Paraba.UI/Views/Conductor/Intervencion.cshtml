@model Paraba.UI.ViewModels.IntervencionConductorViewModel

@{
    ViewData["Title"] = $"{Model.Accion} conductor";
    string accionPost = Model.Accion == "Suspender" ? "ConfirmarSuspension" : "ConfirmarReactivacion";
    string textoBoton = Model.Accion == "Suspender" ? "Confirmar suspension" : "Confirmar reactivacion";
    string claseBoton = Model.Accion == "Suspender" ? "btn btn-danger" : "btn btn-success";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">@(Model.Accion) conductor</h1>
        <p class="text-muted mb-0">Intervencion administrativa con motivo obligatorio.</p>
    </div>
    <a asp-controller="Conductor" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>

<div class="border rounded p-3 mb-3">
    <div><strong>Conductor:</strong> @Model.Conductor</div>
    <div><strong>Documento:</strong> @Model.DocumentoIdentidad</div>
    <div><strong>Estado actual:</strong> @Model.EstadoActual</div>
</div>

<form asp-controller="Conductor" asp-action="@accionPost" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input asp-for="IdConductor" type="hidden" />
    <input asp-for="Accion" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-12">
        <label asp-for="Motivo" class="form-label">Motivo administrativo</label>
        <textarea asp-for="Motivo" class="form-control" rows="4" maxlength="300"></textarea>
        <span asp-validation-for="Motivo" class="text-danger"></span>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="@claseBoton">@textoBoton</button>
        <a asp-controller="Conductor" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
