@model Paraba.UI.ViewModels.DetalleConductorViewModel

@{
    ViewData["Title"] = "Detalle de conductor";
    bool puedeIntervenirConductores = User.IsInRole("SuperAdmin") || User.IsInRole("Verificador");
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Detalle de conductor #@Model.IdConductor</h1>
        <p class="text-muted mb-0">Vista administrativa para verificacion, soporte y control operativo.</p>
    </div>
    <div class="d-flex gap-2">
        @if (puedeIntervenirConductores && Model.Estado)
        {
            <a asp-controller="Conductor" asp-action="Suspender" asp-route-id="@Model.IdConductor" class="btn btn-outline-danger">Suspender</a>
        }
        else if (puedeIntervenirConductores)
        {
            <a asp-controller="Conductor" asp-action="Reactivar" asp-route-id="@Model.IdConductor" class="btn btn-outline-success">Reactivar</a>
        }
        <a asp-controller="Conductor" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>

<div class="detail-grid">
    <section class="detail-panel">
        <h2>Conductor</h2>
        <div class="detail-list">
            <div class="detail-row">
                <span class="detail-label">Nombre</span>
                <span class="detail-value">@Model.NombreCompleto</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Documento</span>
                <span class="detail-value">@Model.DocumentoIdentidad</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Telefono</span>
                <span class="detail-value">@Model.Telefono</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Correo</span>
                <span class="detail-value">@Model.Correo</span>
            </div>
        </div>
    </section>

    <section class="detail-panel">
        <h2>Estado operativo</h2>
        <div class="detail-list">
            <div class="detail-row">
                <span class="detail-label">Estado</span>
                <span class="detail-value">
                    <span class="status-badge @(Model.Estado ? "status-success" : "status-danger")">
                        @(Model.Estado ? "Activo" : "Suspendido")
                    </span>
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Disponible</span>
                <span class="detail-value">
                    <span class="status-badge @(Model.Disponible ? "status-success" : "status-muted")">
                        @(Model.Disponible ? "Si" : "No")
                    </span>
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Verificado</span>
                <span class="detail-value">
                    <span class="status-badge @(Model.Verificado ? "status-success" : "status-warning")">
                        @(Model.Verificado ? "Si" : "Pendiente")
                    </span>
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Calificacion</span>
                <span class="detail-value">@Model.PromedioCalificacion.ToString("0.00") / 5</span>
            </div>
        </div>
    </section>

    <section class="detail-panel">
        <h2>Licencia y vehiculo</h2>
        <div class="detail-list">
            <div class="detail-row">
                <span class="detail-label">Licencia</span>
                <span class="detail-value">@Model.LicenciaConducir</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Vencimiento</span>
                <span class="detail-value">@Model.FechaVencimientoLicencia.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Modalidad</span>
                <span class="detail-value">@Model.TipoServicio</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Vehiculo</span>
                <span class="detail-value">@Model.Vehiculo - @Model.Placa</span>
            </div>
        </div>
    </section>
</div>

<section class="detail-panel mb-3">
    <h2>Documentos</h2>

    @if (!Model.Documentos.Any())
    {
        <div class="alert alert-secondary mb-0">El conductor aun no tiene documentos registrados.</div>
    }
    else
    {
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Documento</th>
                    <th>Numero</th>
                    <th>Archivo</th>
                    <th>Vencimiento</th>
                    <th>Estado</th>
                    <th>Observacion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var documento in Model.Documentos)
                {
                    var estadoDocumentoClase = documento.EstadoVerificacion switch
                    {
                        "Aprobado" => "status-success",
                        "Rechazado" => "status-danger",
                        _ => "status-warning"
                    };

                    <tr>
                        <td>@documento.TipoDocumento</td>
                        <td>@documento.NumeroDocumento</td>
                        <td>@documento.UrlArchivo</td>
                        <td>@(documento.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "No aplica")</td>
                        <td><span class="status-badge @estadoDocumentoClase">@documento.EstadoVerificacion</span></td>
                        <td>@documento.Observacion</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="detail-panel mb-3">
    <h2>Calificaciones</h2>

    @if (!Model.Calificaciones.Any())
    {
        <div class="alert alert-secondary mb-0">El conductor aun no tiene calificaciones registradas.</div>
    }
    else
    {
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Viaje</th>
                    <th>Pasajero</th>
                    <th>Puntaje</th>
                    <th>Comentario</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var calificacion in Model.Calificaciones)
                {
                    <tr>
                        <td>@calificacion.IdViaje</td>
                        <td>@calificacion.Pasajero</td>
                        <td><strong>@calificacion.Puntaje / 5</strong></td>
                        <td>@calificacion.Comentario</td>
                        <td>@calificacion.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="detail-panel">
    <h2>Auditoria del conductor</h2>

    @if (!Model.Auditorias.Any())
    {
        <div class="alert alert-secondary mb-0">El conductor aun no tiene eventos de auditoria registrados.</div>
    }
    else
    {
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>Accion</th>
                    <th>Estado anterior</th>
                    <th>Estado nuevo</th>
                    <th>Usuario</th>
                    <th>Observacion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var auditoria in Model.Auditorias)
                {
                    <tr>
                        <td>@auditoria.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@auditoria.Accion</td>
                        <td>@auditoria.EstadoAnterior</td>
                        <td>@auditoria.EstadoNuevo</td>
                        <td>@auditoria.UsuarioSistema</td>
                        <td>@auditoria.Observacion</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
