@model List<Paraba.ENTITY.Models.Conductor>

@{
    ViewData["Title"] = "Conductores";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Conductores</h1>
        <p class="text-muted mb-0">Registro inicial de conductores de PARABA.</p>
    </div>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Telefono</th>
            <th>Licencia</th>
            <th>Disponible</th>
            <th>Verificado</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var conductor in Model)
        {
            <tr>
                <td>@conductor.IdConductor</td>
                <td>
                    <strong>@conductor.NombreCompleto</strong>
                    <div class="text-muted small">@conductor.Correo</div>
                </td>
                <td>@conductor.Telefono</td>
                <td>@conductor.LicenciaConducir</td>
                <td>
                    <span class="status-badge @(conductor.Disponible ? "status-success" : "status-muted")">
                        @(conductor.Disponible ? "Disponible" : "No disponible")
                    </span>
                </td>
                <td>
                    <span class="status-badge @(conductor.Verificado ? "status-success" : "status-warning")">
                        @(conductor.Verificado ? "Verificado" : "Pendiente")
                    </span>
                </td>
                <td>
                    <span class="status-badge @(conductor.Estado ? "status-success" : "status-danger")">
                        @(conductor.Estado ? "Activo" : "Suspendido")
                    </span>
                </td>
                <td>
                    <div class="table-actions mb-1">
                        <a asp-controller="Conductor" asp-action="Detalle" asp-route-id="@conductor.IdConductor" class="btn btn-sm btn-outline-secondary">
                            Detalle
                        </a>
                    </div>
                    @if (conductor.Estado)
                    {
                        <div class="table-actions">
                            <a asp-controller="Conductor" asp-action="Suspender" asp-route-id="@conductor.IdConductor" class="btn btn-sm btn-outline-danger">
                                Suspender
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-actions">
                            <a asp-controller="Conductor" asp-action="Reactivar" asp-route-id="@conductor.IdConductor" class="btn btn-sm btn-outline-success">
                                Reactivar
                            </a>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
