@model List<Paraba.UI.ViewModels.VehiculoViewModel>

@{
    ViewData["Title"] = "Vehiculos";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Vehiculos</h1>
        <p class="text-muted mb-0">Vehiculos registrados para operar en PARABA.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Conductor</th>
            <th>Tipo servicio</th>
            <th>Placa</th>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Color</th>
            <th>Anio</th>
            <th>Revisión</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var vehiculo in Model)
        {
            <tr>
                <td>@vehiculo.IdVehiculo</td>
                <td>@vehiculo.Conductor</td>
                <td>@vehiculo.TipoServicio</td>
                <td><strong>@vehiculo.Placa</strong></td>
                <td>@vehiculo.Marca</td>
                <td>@vehiculo.Modelo</td>
                <td>@vehiculo.Color</td>
                <td>@vehiculo.Anio</td>
                <td>
                    <strong>@vehiculo.EstadoVerificacion</strong>
                    @if (!string.IsNullOrWhiteSpace(vehiculo.Observacion))
                    {
                        <div class="small text-muted">@vehiculo.Observacion</div>
                    }
                </td>
                <td>@(vehiculo.Estado ? "Activo" : "Inactivo")</td>
                <td>
                    @if (vehiculo.EstadoVerificacion == "Pendiente")
                    {
                        <form asp-action="Revisar" method="post" class="d-flex flex-column gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idVehiculo" value="@vehiculo.IdVehiculo" />
                            <input class="form-control form-control-sm" name="observacion" placeholder="Observación o motivo de rechazo" />
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-success" name="estado" value="Aprobado">Aprobar</button>
                                <button class="btn btn-sm btn-outline-danger" name="estado" value="Rechazado">Rechazar</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">Revisión cerrada</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
