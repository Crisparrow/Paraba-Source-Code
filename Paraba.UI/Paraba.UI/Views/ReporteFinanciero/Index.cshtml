@model Paraba.UI.ViewModels.ReporteFinancieroViewModel

@{
    ViewData["Title"] = "Reporte financiero";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Reporte financiero</h1>
        <p class="text-muted mb-0">Resumen de ingresos, comisiones y pagos a conductores.</p>
    </div>
</div>

<form asp-controller="ReporteFinanciero" asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label">Desde</label>
        <input asp-for="FechaDesde" class="form-control" type="date" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Hasta</label>
        <input asp-for="FechaHasta" class="form-control" type="date" />
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filtrar</button>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="border rounded p-3"><div class="text-muted small">Bruto viajes</div><div class="h4 mb-0">@Model.TotalBrutoViajes.ToString("0.00")</div></div></div>
    <div class="col-md-3"><div class="border rounded p-3"><div class="text-muted small">Comision PARABA</div><div class="h4 mb-0">@Model.TotalComisionParaba.ToString("0.00")</div></div></div>
    <div class="col-md-3"><div class="border rounded p-3"><div class="text-muted small">Pendiente pago</div><div class="h4 mb-0">@Model.NetoPendientePago.ToString("0.00")</div></div></div>
    <div class="col-md-3"><div class="border rounded p-3"><div class="text-muted small">Pagado</div><div class="h4 mb-0">@Model.NetoPagado.ToString("0.00")</div></div></div>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr><th>ID</th><th>Conductor</th><th>Estado</th><th>Cierre</th><th>Bruto</th><th>Comision</th><th>Neto</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.IdLiquidacionConductor</td>
                    <td>@item.Conductor</td>
                    <td>@item.Estado</td>
                    <td>@item.FechaCierre.ToString("dd/MM/yyyy")</td>
                    <td>@item.TotalBruto.ToString("0.00")</td>
                    <td>@item.ComisionParaba.ToString("0.00")</td>
                    <td>@item.NetoConductor.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
