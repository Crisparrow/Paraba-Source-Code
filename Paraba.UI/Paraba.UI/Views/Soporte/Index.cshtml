@model Paraba.UI.ViewModels.SoporteOperativoViewModel

@{
    ViewData["Title"] = "Soporte operativo";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Soporte operativo</h1>
        <p class="text-muted mb-0">Casos que requieren revision humana: cancelaciones, calificaciones bajas y viajes sin cierre.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted small">Viajes cancelados</div>
            <div class="h4 mb-0">@Model.ViajesCancelados</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted small">Calificaciones bajas</div>
            <div class="h4 mb-0">@Model.CalificacionesBajas</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted small">Viajes sin cierre</div>
            <div class="h4 mb-0">@Model.ViajesSinCierre</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted small">Conductores suspendidos</div>
            <div class="h4 mb-0">@Model.ConductoresSuspendidos</div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Prioridad</th>
                <th>Caso</th>
                <th>Viaje</th>
                <th>Pasajero</th>
                <th>Conductor</th>
                <th>Ruta</th>
                <th>Detalle</th>
                <th>Fecha</th>
                <th>Accion</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var caso in Model.Casos)
            {
                var prioridadClase = caso.Prioridad == "Alta" ? "status-danger" : "status-warning";

                <tr>
                    <td><span class="status-badge @prioridadClase">@caso.Prioridad</span></td>
                    <td>@caso.TipoCaso</td>
                    <td>@(caso.IdViaje?.ToString() ?? "-")</td>
                    <td>@caso.Pasajero</td>
                    <td>@caso.Conductor</td>
                    <td>@caso.Ruta</td>
                    <td>@caso.Detalle</td>
                    <td>@caso.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (caso.IdViaje != null)
                        {
                            <a asp-controller="Viaje" asp-action="Detalle" asp-route-id="@caso.IdViaje" class="btn btn-sm btn-outline-secondary">Ver viaje</a>
                        }
                        else
                        {
                            <span class="text-muted">Sin viaje</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Casos.Any())
{
    <div class="alert alert-info">
        No hay casos operativos pendientes de revision.
    </div>
}
