@model List<Paraba.UI.ViewModels.ViajeViewModel>

@{
    ViewData["Title"] = "Viajes";
    bool puedeCancelarViajes = User.IsInRole("SuperAdmin") || User.IsInRole("Operaciones");
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Viajes</h1>
        <p class="text-muted mb-0">Monitoreo administrativo de solicitudes y viajes creados desde las apps.</p>
    </div>
</div>

<div class="alert alert-info">
    Este panel no crea viajes ni actua como pasajero o conductor. Las solicitudes, ofertas, contraofertas, inicio y finalizacion se realizan desde las apps correspondientes.
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Pasajero</th>
            <th>Conductor</th>
            <th>Tipo servicio</th>
            <th>Vehiculo</th>
            <th>Ruta</th>
            <th>Sugerida</th>
            <th>Oferta pasajero</th>
            <th>Contraoferta</th>
            <th>Aceptada</th>
            <th>Estado</th>
            <th>Solicitud</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var viaje in Model)
        {
            var estadoClase = viaje.EstadoViaje switch
            {
                "Aceptado" => "status-success",
                "En curso" => "status-info",
                "Finalizado" => "status-muted",
                "Cancelado" => "status-danger",
                _ => "status-warning"
            };

            <tr>
                <td>@viaje.IdViaje</td>
                <td>@viaje.Pasajero</td>
                <td>@viaje.Conductor</td>
                <td>@viaje.TipoServicio</td>
                <td>@viaje.Vehiculo</td>
                <td>
                    <strong>@viaje.Origen</strong>
                    <div class="text-muted small">@viaje.Destino</div>
                </td>
                <td><span class="money-value">@viaje.TarifaSugerida.ToString("0.00")</span></td>
                <td><span class="money-value">@viaje.TarifaOfertada.ToString("0.00")</span></td>
                <td>
                    @if (viaje.TarifaContraoferta.HasValue)
                    {
                        <span class="money-value">@viaje.TarifaContraoferta.Value.ToString("0.00")</span>
                    }
                    else
                    {
                        <span class="text-muted">Sin contraoferta</span>
                    }
                </td>
                <td>
                    @if (viaje.TarifaAceptada.HasValue)
                    {
                        <span class="money-value">@viaje.TarifaAceptada.Value.ToString("0.00")</span>
                    }
                    else
                    {
                        <span class="status-badge status-warning">Pendiente</span>
                    }
                </td>
                <td><span class="status-badge @estadoClase">@viaje.EstadoViaje</span></td>
                <td>@viaje.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <div class="table-actions">
                        <a asp-controller="Viaje" asp-action="Detalle" asp-route-id="@viaje.IdViaje" class="btn btn-sm btn-outline-secondary w-100">
                            Detalle
                        </a>
                        @if (puedeCancelarViajes && viaje.EstadoViaje != "Finalizado" && viaje.EstadoViaje != "Cancelado")
                        {
                            <a asp-controller="Viaje" asp-action="Cancelar" asp-route-id="@viaje.IdViaje" class="btn btn-sm btn-outline-danger w-100">
                                Cancelar admin
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">Sin acciones</span>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
