@model Paraba.UI.ViewModels.ContraofertaViajeViewModel

@{
    ViewData["Title"] = "Contraoferta";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Contraoferta del conductor</h1>
        <p class="text-muted mb-0">Respuesta del conductor a la oferta del pasajero.</p>
    </div>
    <a asp-controller="Viaje" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>

<div class="mb-3">
    <div><strong>Pasajero:</strong> @Model.Pasajero</div>
    <div><strong>Conductor:</strong> @Model.Conductor</div>
    <div><strong>Ruta:</strong> @Model.Ruta</div>
    <div><strong>Tarifa sugerida:</strong> @Model.TarifaSugerida.ToString("0.00")</div>
    <div><strong>Oferta pasajero:</strong> @Model.TarifaOfertada.ToString("0.00")</div>
    <div><strong>Contraoferta actual:</strong> @(Model.TarifaContraofertaActual?.ToString("0.00") ?? "Sin contraoferta")</div>
</div>

<form asp-controller="Viaje" asp-action="Contraoferta" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input asp-for="IdViaje" type="hidden" />
    <input asp-for="Pasajero" type="hidden" />
    <input asp-for="Conductor" type="hidden" />
    <input asp-for="Ruta" type="hidden" />
    <input asp-for="TarifaSugerida" type="hidden" />
    <input asp-for="TarifaOfertada" type="hidden" />
    <input asp-for="TarifaContraofertaActual" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-4">
        <label class="form-label">Nueva contraoferta</label>
        <input asp-for="NuevaContraoferta" class="form-control" type="number" step="0.1" min="0.1" />
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar contraoferta</button>
        <a asp-controller="Viaje" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
