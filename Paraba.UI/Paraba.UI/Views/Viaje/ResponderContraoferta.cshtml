@model Paraba.UI.ViewModels.ResponderContraofertaViewModel

@{
    ViewData["Title"] = "Responder contraoferta";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Respuesta del pasajero</h1>
        <p class="text-muted mb-0">Revision de la contraoferta enviada por el conductor.</p>
    </div>
    <a asp-controller="Viaje" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>

<table class="table table-bordered align-middle">
    <tbody>
        <tr>
            <th>Pasajero</th>
            <td>@Model.Pasajero</td>
        </tr>
        <tr>
            <th>Conductor</th>
            <td>@Model.Conductor</td>
        </tr>
        <tr>
            <th>Ruta</th>
            <td>@Model.Ruta</td>
        </tr>
        <tr>
            <th>Tarifa sugerida PARABA</th>
            <td>@Model.TarifaSugerida.ToString("0.00")</td>
        </tr>
        <tr>
            <th>Oferta del pasajero</th>
            <td>@Model.TarifaOfertada.ToString("0.00")</td>
        </tr>
        <tr>
            <th>Contraoferta del conductor</th>
            <td>@(Model.TarifaContraoferta?.ToString("0.00") ?? "Sin contraoferta")</td>
        </tr>
        <tr>
            <th>Tarifa aceptada</th>
            <td>@(Model.TarifaAceptada?.ToString("0.00") ?? "Pendiente")</td>
        </tr>
    </tbody>
</table>

@if (Model.TarifaAceptada != null)
{
    <div class="alert alert-success">
        El viaje ya tiene una tarifa aceptada.
    </div>
}
else if (Model.TarifaContraoferta == null)
{
    <div class="alert alert-warning">
        Este viaje todavia no tiene contraoferta del conductor.
    </div>
}
else
{
    <form asp-controller="Viaje" asp-action="AceptarContraoferta" method="post" class="d-flex gap-2">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idViaje" value="@Model.IdViaje" />
        <button type="submit" class="btn btn-success">Aceptar contraoferta</button>
        <a asp-controller="Viaje" asp-action="Index" class="btn btn-outline-secondary">Mantener pendiente</a>
    </form>
}
