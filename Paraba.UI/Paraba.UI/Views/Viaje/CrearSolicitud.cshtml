@model Paraba.UI.ViewModels.SolicitudViajeViewModel

@{
    ViewData["Title"] = "Nueva solicitud";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Nueva solicitud</h1>
        <p class="text-muted mb-0">Registro administrativo del flujo tipo oferta y contraoferta.</p>
    </div>
    <a asp-controller="Viaje" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-controller="Viaje" asp-action="CrearSolicitud" method="post" class="row g-3">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <label class="form-label">Pasajero</label>
        <select asp-for="IdPasajero" asp-items="Model.Pasajeros" class="form-select"></select>
    </div>

    <div class="col-md-6">
        <label class="form-label">Tipo de servicio</label>
        <select asp-for="IdTipoServicio" asp-items="Model.TiposServicio" class="form-select"></select>
    </div>

    <div class="col-md-6">
        <label class="form-label">Conductor</label>
        <select asp-for="IdConductor" asp-items="Model.Conductores" class="form-select"></select>
        <div class="form-text">Solo aparecen conductores activos, verificados y disponibles.</div>
    </div>

    <div class="col-md-6">
        <label class="form-label">Vehiculo</label>
        <select asp-for="IdVehiculo" asp-items="Model.Vehiculos" class="form-select"></select>
        <div class="form-text">El vehiculo debe pertenecer al conductor y coincidir con taxi o moto taxi.</div>
    </div>

    <div class="col-md-6">
        <label class="form-label">Origen</label>
        <input asp-for="Origen" class="form-control" />
    </div>

    <div class="col-md-6">
        <label class="form-label">Destino</label>
        <input asp-for="Destino" class="form-control" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Distancia kilometros</label>
        <input asp-for="DistanciaKilometros" class="form-control" type="number" step="0.1" min="0.1" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Tiempo minutos</label>
        <input asp-for="TiempoMinutos" class="form-control" type="number" min="1" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Oferta pasajero</label>
        <input asp-for="TarifaOfertada" class="form-control" type="number" step="0.1" min="0" />
        @if (Model.TarifaSugerida <= 0)
        {
            <div class="form-text">Primero calcula la sugerencia de PARABA.</div>
        }
    </div>

    @if (Model.TarifaSugerida > 0)
    {
        <div class="col-12">
            <div class="alert alert-info mb-0">
                Tarifa sugerida por PARABA: <strong>@Model.TarifaSugerida.ToString("0.00")</strong>.
                Oferta registrada: <strong>@Model.TarifaOfertada.ToString("0.00")</strong>.
            </div>
        </div>
    }

    <div class="col-12 d-flex gap-2">
        <button type="submit" name="accion" value="Calcular" class="btn btn-outline-primary">Calcular sugerencia</button>
        @if (Model.TarifaSugerida > 0)
        {
            <button type="submit" name="accion" value="Guardar" class="btn btn-primary">Guardar solicitud</button>
        }
        <a asp-controller="Viaje" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
