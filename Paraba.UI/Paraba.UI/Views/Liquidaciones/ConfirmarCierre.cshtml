@model Paraba.UI.ViewModels.ConfirmarCierreLiquidacionViewModel

@{
    ViewData["Title"] = "Confirmar cierre";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Confirmar cierre de liquidacion</h1>
        <p class="text-muted mb-0">Revise los viajes, comision y neto antes de cerrar la liquidacion del conductor.</p>
    </div>
    <a asp-controller="Liquidaciones" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-controller="Liquidaciones" asp-action="CerrarConfirmado" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="FechaDesde" type="hidden" />
    <input asp-for="FechaHasta" type="hidden" />
    <input asp-for="IdConductor" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="border rounded p-3">
                <div class="text-muted small">Conductor</div>
                <div class="fw-semibold">@Model.Conductor</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded p-3">
                <div class="text-muted small">Periodo</div>
                <div class="fw-semibold">@Model.FechaDesde?.ToString("dd/MM/yyyy") - @Model.FechaHasta?.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="border rounded p-3">
                <div class="text-muted small">Viajes</div>
                <div class="h4 mb-0">@Model.TotalViajesFinalizados</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="border rounded p-3">
                <div class="text-muted small">Comision</div>
                <div class="h4 mb-0">@Model.TotalComisionParaba.ToString("0.00")</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="border rounded p-3">
                <div class="text-muted small">Neto conductor</div>
                <div class="h4 mb-0">@Model.TotalNetoConductor.ToString("0.00")</div>
            </div>
        </div>
    </div>

    <div class="alert alert-warning">
        Al confirmar, estos viajes quedaran asociados a una liquidacion cerrada y no volveran a aparecer como pendientes de liquidar.
    </div>

    <div class="mb-4">
        <label asp-for="ObservacionCierre" class="form-label">Observacion de cierre</label>
        <textarea asp-for="ObservacionCierre" class="form-control" rows="3" placeholder="Ejemplo: cierre semanal revisado por finanzas."></textarea>
        <span asp-validation-for="ObservacionCierre" class="text-danger"></span>
    </div>

    <div class="table-responsive mb-4">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Viaje</th>
                    <th>Pasajero</th>
                    <th>Servicio</th>
                    <th>Ruta</th>
                    <th>Tarifa final</th>
                    <th>Comision PARABA</th>
                    <th>Neto conductor</th>
                    <th>Fecha fin</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Liquidaciones)
                {
                    <tr>
                        <td>@item.IdViaje</td>
                        <td>@item.Pasajero</td>
                        <td>@item.TipoServicio</td>
                        <td>@item.Ruta</td>
                        <td>@item.TarifaFinal.ToString("0.00")</td>
                        <td>@item.ComisionParaba.ToString("0.00")</td>
                        <td>@item.NetoConductor.ToString("0.00")</td>
                        <td>@item.FechaFin.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Confirmar y cerrar liquidacion</button>
        <a asp-controller="Liquidaciones" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
