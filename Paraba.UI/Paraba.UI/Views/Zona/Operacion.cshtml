@model Paraba.UI.ViewModels.ZonaViewModel

@{
    ViewData["Title"] = "Operacion zona";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Control operativo de zona</h1>
        <p class="text-muted mb-0">@Model.Ciudad - @Model.Nombre</p>
    </div>
    <a asp-controller="Zona" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-controller="Zona" asp-action="Operacion" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input asp-for="IdZona" type="hidden" />

    <div class="col-md-4">
        <div class="form-check">
            <input asp-for="CoberturaActiva" class="form-check-input" />
            <label asp-for="CoberturaActiva" class="form-check-label">Cobertura activa</label>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-check">
            <input asp-for="EsZonaRiesgo" class="form-check-input" />
            <label asp-for="EsZonaRiesgo" class="form-check-label">Zona de riesgo</label>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-check">
            <input asp-for="AltaDemanda" class="form-check-input" />
            <label asp-for="AltaDemanda" class="form-check-label">Alta demanda</label>
        </div>
    </div>
    <div class="col-12">
        <label asp-for="ObservacionOperativa" class="form-label">Observacion operativa</label>
        <textarea asp-for="ObservacionOperativa" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Guardar control operativo</button>
    </div>
</form>
