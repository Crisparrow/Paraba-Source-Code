@model List<Paraba.UI.ViewModels.ZonaViewModel>

@{
    ViewData["Title"] = "Zonas";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">Zonas</h1>
        <p class="text-muted mb-0">Zonas operativas para viajes, demanda y reglas de tarifa.</p>
    </div>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Ciudad</th>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>Cobertura</th>
            <th>Riesgo</th>
            <th>Demanda</th>
            <th>Observacion operativa</th>
            <th>Estado</th>
            <th>Registro</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var zona in Model)
        {
            <tr>
                <td>@zona.IdZona</td>
                <td>@zona.Ciudad</td>
                <td><strong>@zona.Nombre</strong></td>
                <td>@zona.Descripcion</td>
                <td>@(zona.CoberturaActiva ? "Activa" : "Sin cobertura")</td>
                <td>@(zona.EsZonaRiesgo ? "Riesgo" : "Normal")</td>
                <td>@(zona.AltaDemanda ? "Alta" : "Normal")</td>
                <td>@zona.ObservacionOperativa</td>
                <td>@(zona.Estado ? "Activo" : "Inactivo")</td>
                <td>@zona.FechaRegistro.ToString("dd/MM/yyyy")</td>
                <td>
                    <a asp-controller="Zona" asp-action="Operacion" asp-route-id="@zona.IdZona" class="btn btn-sm btn-outline-primary">Operacion</a>
                </td>
            </tr>
        }
    </tbody>
</table>
